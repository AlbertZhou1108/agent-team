{
  "name": "agent-team-local",
  "version": "0.4.1",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "description": "Local single-user CLI agent groups with independent pair conversations",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agent-team": "src/cli.mjs"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node --disable-warning=ExperimentalWarning src/cli.mjs",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning src/cli.mjs serve --data work/dev --port 62048",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test test/contract/*.test.mjs test/internal/*.test.mjs test/process/*.test.mjs && vitest run --config web/vite.config.ts",
    "test:core": "node --disable-warning=ExperimentalWarning --test test/contract/*.test.mjs test/internal/*.test.mjs test/process/*.test.mjs",
    "test:web": "vitest run --config web/vite.config.ts",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "lint:backend": "eslint src test scripts electron",
    "check": "node scripts/check.mjs && node scripts/check-design.mjs && npm run typecheck && npm run typecheck:backend && npm run lint:backend",
    "launch": "node --disable-warning=ExperimentalWarning src/launcher.mjs",
    "package": "npm run build && node scripts/build-release.mjs",
    "desktop": "npm run build && node electron/launch.mjs",
    "desktop:quick": "node electron/launch.mjs",
    "desktop:dev": "node electron/dev.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.60.0",
    "@tanstack/vue-query": "^5.104.5",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.17",
    "jpeg-js": "^0.4.4",
    "marked": "^18.1.1",
    "pinia": "^4.1.0",
    "pngjs": "^7.0.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "electron": "45.2.3",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
